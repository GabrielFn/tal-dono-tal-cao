# Copie este arquivo para .env.local (local) ou cadastre as variáveis na Vercel.

# Chave da API da Anthropic (console.anthropic.com). Sem ela, o app roda em MODO DEMO
# (resultados de exemplo, sem IA de verdade).
ANTHROPIC_API_KEY=

# Modelo usado na análise. Haiku é o mais barato; troque para claude-sonnet-5-5 se quiser
# respostas mais caprichadas (custa mais por análise).
ANTHROPIC_MODEL=claude-haiku-5-5

# Força o modo demo mesmo com chave (útil para testar a interface sem gastar). 1 = ligado.
DEMO_MODE=0

# Limites de uso para proteger o seu orçamento de API.
LIMITE_DIARIO_POR_IP=5
LIMITE_DIARIO_GLOBAL=500

# (Opcional, recomendado em produção) Upstash Redis para o limite de uso funcionar
# entre todas as instâncias da Vercel. Crie grátis em upstash.com > Redis > REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Endereço público do site (aparece no card compartilhado e nos links de preview).
NEXT_PUBLIC_SITE_URL=
# (vazio = usa o domínio de produção da Vercel, hoje https://tal-dono-tal-cao.vercel.app)

# E-mail de contato exibido na política de privacidade (exigência da LGPD).
NEXT_PUBLIC_CONTATO_EMAIL=contato@taldonotalcao.com.br

# ---- Pacote Premium (Pix) ----
# Access Token de PRODUÇÃO do Mercado Pago (começa com APP_USR-). Em:
# mercadopago.com.br/developers > Suas integrações > Criar aplicação > Credenciais de produção.
# Sem ele, o Pix roda em MODO DEMO: libera sozinho em alguns segundos, sem cobrar nada.
MERCADOPAGO_ACCESS_TOKEN=

# Força o Pix de demonstração mesmo com token (útil para testar). 1 = ligado.
PIX_DEMO=0

# Preço do pacote em centavos (490 = R$ 4,90).
PRECO_PREMIUM_CENTAVOS=490

# Quantos Pix cada pessoa (IP) pode gerar por dia, e o total do site.
LIMITE_PIX_POR_IP=10
LIMITE_PIX_GLOBAL=2000
